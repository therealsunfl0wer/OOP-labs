        <file alias="rectangle">resources/draw-rectangle.svg</file>
        <file alias="point">resources/draw-point.svg</file>
        <file alias="ellipse">resources/draw-ellipse.svg</file>
        <file alias="line">resources/draw-line.svg</file>
        <file alias="o-o-line">resources/draw-o-o-line.svg</file>
        <file alias="cuboid">resources/draw-cuboid.svg</file>
    </qresource>
</RCC>
